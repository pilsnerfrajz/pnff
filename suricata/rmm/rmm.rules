# RustDesk v1.4.5
alert dns any any -> any any (msg:"RustDesk DNS Response"; dns.answers.rrname; content:"rustdesk"; nocase; sid:1000001; rev:1;)
alert tls any any -> any any (msg:"'RustDesk' in TLS SNI"; tls.sni; content:"rustdesk"; nocase;  sid:1000002; rev:1;)
alert tls any any -> any any (msg:"RustDesk JA4 Fingerprint Match"; ja4.hash; content:"t13d1011h1_61a7ad8aa9b6_3fcd1a44f3e3"; sid:1000023; rev:1;)
alert tcp any any -> any 21115 (msg:"Possible RustDesk connection (port-based)"; sid:1000016; rev:1;)
alert tcp any any -> any 21116 (msg:"Possible RustDesk connection (port-based)"; sid:1000017; rev:1;)
alert udp any any -> any 21116 (msg:"Possible RustDesk connection (port-based)"; sid:1000022; rev:1;)
alert tcp any any -> any 21117 (msg:"Possible RustDesk connection (port-based)"; sid:1000018; rev:1;)
alert tcp any any -> any 21118 (msg:"Possible RustDesk connection (port-based)"; sid:1000019; rev:1;)
alert tcp any any -> any 21119 (msg:"Possible RustDesk connection (port-based)"; sid:1000020; rev:1;)


