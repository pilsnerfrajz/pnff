# UltraVNC v1.6.4.0
# Checks for initial VNC handshake version exchange, e.g. RFB 003.008
alert tcp any any -> any 5900 (msg:"VNC Connection"; flow:established; content:"RFB "; startswith; sid:1000009; rev:1;)


# AnyDesk v9.6.7
alert dns any any -> any any (msg: "AnyDesk DNS Response"; dns.answers.rrname; content:"anydesk"; nocase; sid:1000034; rev:1;)
alert tls any any -> any any (msg:"'AnyDesk' in TLS ALPN"; tls.alpn; content:"anydesk"; nocase; sid:1000010; rev:1;)
alert tls any any -> any any (msg:"AnyDesk JA4 Fingerprint Match"; ja4.hash; content:"t13i3110as_e8f1e7e78f70_1f22a2ca17c4"; sid:1000025; rev:1;)
alert tls any any -> any any (msg:"AnyDesk JA4 Fingerprint Match"; ja4.hash; content:"t13i310900_e8f1e7e78f70_1f22a2ca17c4"; sid:1000048; rev:1;)
alert http any any -> any any (msg:"AnyDesk HTTP Connection"; flow:established,to_server; http.method; content:"POST"; nocase; http.user_agent; content:"anydesk"; sid:1000011; rev:1;)
alert tcp any any -> any 7070 (msg:"Possible AnyDesk SYN Connection (port-based)"; flow:to_server; tcp.flags:S; sid:1000041; rev:1;)
# https://support.anydesk.com/docs/firewall
alert tcp any any -> any 6568 (msg:"Possible AnyDesk Connection (port-based)"; sid:1000042; rev:1;)
alert udp any any -> 239.255.102.18 50001 (msg:"AnyDesk Network Discovery Traffic"; sid:1000043; rev:1;)
alert udp any any -> 239.255.102.18 50002 (msg:"AnyDesk Network Discovery Traffic"; sid:1000044; rev:1;)
alert udp any any -> 239.255.102.18 50003 (msg:"AnyDesk Network Discovery Traffic"; sid:1000045; rev:1;)


# AnyViewer v5.5.0
alert dns any any -> any any (msg:"Possible AnyViewer DNS Query (Geolocation Lookup)"; dns.answers.rrname; content:"ip138"; nocase; sid:1000101; rev:1;)
alert dns any any -> any any (msg:"AnyViewer DNS Sequence (Geolocation + AnyViewer Server)"; dns.answers.rrname; content:"aomeisoftware"; sid:1000116; rev:1;)
alert tls any any -> any any (msg:"AnyViewer Domain in TLS SNI"; tls.sni; content:"aomeisoftware"; nocase; sid:1000012; rev:1;)
alert tcp any any -> any 30192 (msg:"Possible AnyViewer Connection (port-based)"; sid:1000031; rev:1;)
alert tcp any any -> any 30193 (msg:"Possible AnyViewer Connection (port-based)"; sid:1000032; rev:1;)
alert udp any any -> any 30196 (msg:"Possible AnyViewer Connection (port-based)"; sid:1000033; rev:1;)
# Check for connection to ip138 prior to JA4 hash to separate AnyViewer from TeamViewer
alert tls any any -> any any (msg:"Connection to IP-Lookup Domain Associated with AnyViewer"; tls.sni; content:"ip138"; nocase; xbits:set, ip138conn, track ip_src, expire 60; sid:1000036; rev:1;)
alert tls any any -> any any (msg:"AnyViewer JA4 Fingerprint Match"; ja4.hash; content:"t12d2108h1_76e208dd3e22_2dae41c691ec"; xbits:isset, ip138conn, track ip_src; sid:1000035; rev:1;)
alert tls any any -> any any (msg:"AnyViewer (aomeisoftware) Server Certificate String Match"; tls.version:1.2; content:"|02|"; depth:6; content:"aomeisoftware"; nocase; sid:1000046; rev:1;)


